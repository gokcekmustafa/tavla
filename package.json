{
  "name": "tavla-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && npx wrangler dev",
    "build": "tsc -b && vite build",
    "guard:lobby-sync": "node scripts/guard-lobby-sync.mjs",
    "guard:critical": "node scripts/guard-critical-flows.mjs",
    "check:safe": "npm run guard:lobby-sync && npm run guard:critical && npm run build",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run build && npx cap sync android",
    "cap:run:ios": "npm run build && npx cap sync ios",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
