{
  "name": "tavla-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && npx wrangler dev",
    "build": "tsc -b && vite build",
    "guard:lobby-sync": "node scripts/guard-lobby-sync.mjs",
    "guard:critical": "node scripts/guard-critical-flows.mjs",
    "smoke:room-flow": "node scripts/smoke-room-flow.mjs",
    "smoke:realtime": "node scripts/smoke-realtime-resilience.mjs",
    "smoke:identity": "node scripts/smoke-identity-session.mjs",
    "smoke:room-isolation": "node scripts/smoke-room-isolation-access.mjs",
    "smoke:leave-flow": "node scripts/smoke-leave-permission-flow.mjs",
    "smoke:worker-config": "node scripts/smoke-worker-deploy-config.mjs",
    "smoke:chat-scope": "node scripts/smoke-chat-scope.mjs",
    "smoke:entry-room": "node scripts/smoke-entry-room-session.mjs",
    "smoke:legacy-interaction": "node scripts/smoke-legacy-interaction.mjs",
    "smoke:series-scoring": "node scripts/smoke-series-scoring.mjs",
    "smoke:presence-lifecycle": "node scripts/smoke-presence-lifecycle.mjs",
    "smoke:room-start-sync": "node scripts/smoke-room-start-sync.mjs",
    "smoke:two-client-start": "node scripts/smoke-two-client-start.mjs",
    "smoke:room-transition-close": "node scripts/smoke-room-transition-close.mjs",
    "smoke:mobile-drag-fallback": "node scripts/smoke-mobile-drag-fallback.mjs",
    "unit:leave-penalty": "node scripts/unit-leave-penalty-rules.mjs",
    "check:safe": "npm run guard:lobby-sync && npm run guard:critical && npm run smoke:room-flow && npm run smoke:realtime && npm run smoke:identity && npm run smoke:room-isolation && npm run smoke:leave-flow && npm run smoke:worker-config && npm run smoke:chat-scope && npm run smoke:entry-room && npm run smoke:legacy-interaction && npm run smoke:series-scoring && npm run smoke:presence-lifecycle && npm run smoke:room-start-sync && npm run smoke:two-client-start && npm run smoke:room-transition-close && npm run smoke:mobile-drag-fallback && npm run unit:leave-penalty && npm run build",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run build && npx cap sync android",
    "cap:run:ios": "npm run build && npx cap sync ios",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
